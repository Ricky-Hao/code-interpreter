#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat >&2 <<'EOF'
Usage: sandbox-pkg <pip|uv|npm|bun|apt|deb> PACKAGE...

Installs dependencies into the writable per-execution /mnt/deps layer.
Debian packages are extracted without maintainer scripts; the guest and /pkgs
stay read-only, and system services or packages requiring post-install setup
are not supported.
EOF
    exit 2
}

manager="${1:-}"
if [ -z "$manager" ]; then
    usage
fi
shift
if [ "$#" -eq 0 ]; then
    usage
fi

deps_root="/mnt/deps"
data_root="/mnt/data"
if [ "$EUID" -eq 0 ]; then
    deps_root="${SANDBOX_DEPS_ROOT:-$deps_root}"
    data_root="${SANDBOX_DATA_ROOT:-$data_root}"
fi
case "$deps_root" in
    /*) ;;
    *) echo "sandbox-pkg: SANDBOX_DEPS_ROOT must be absolute" >&2; exit 2 ;;
esac
case "$data_root" in
    /*) ;;
    *) echo "sandbox-pkg: SANDBOX_DATA_ROOT must be absolute" >&2; exit 2 ;;
esac
case "$deps_root$data_root" in
    *'"'*|*';'*|*$'\n'*|*$'\r'*)
        echo "sandbox-pkg: dependency paths contain unsupported characters" >&2
        exit 2
        ;;
esac

mkdir -p \
    "$deps_root/.cache" \
    "$deps_root/bin" \
    "$deps_root/tmp"

if [ ! -w "$deps_root" ]; then
    echo "sandbox-pkg: dependency layer is not writable: $deps_root" >&2
    exit 1
fi

prepare_js_root() {
    mkdir -p "$deps_root/js/node_modules" "$deps_root/.cache/npm"
    if [ ! -f "$deps_root/js/package.json" ]; then
        printf '{"private":true}\n' > "$deps_root/js/package.json"
    fi
}

link_missing_module() {
    local source="$1"
    local destination="$2"
    if [ ! -e "$destination" ] && [ ! -L "$destination" ]; then
        ln -s "$source" "$destination"
    fi
}

seed_baked_node_modules() {
    local destination="$deps_root/js/node_modules"
    local module_path entry scope_entry name
    local module_paths=()
    local old_ifs="$IFS"
    IFS=':' read -r -a module_paths <<< "${NODE_PATH:-}"
    IFS="$old_ifs"

    for module_path in "${module_paths[@]}"; do
        [ -n "$module_path" ] || continue
        [ "$module_path" != "$destination" ] || continue
        [ -d "$module_path" ] || continue
        for entry in "$module_path"/*; do
            [ -e "$entry" ] || [ -L "$entry" ] || continue
            name="${entry##*/}"
            if [[ "$name" == @* ]] && [ -d "$entry" ] && [ ! -L "$entry" ]; then
                if [ -L "$destination/$name" ]; then
                    continue
                fi
                mkdir -p "$destination/$name"
                for scope_entry in "$entry"/*; do
                    [ -e "$scope_entry" ] || [ -L "$scope_entry" ] || continue
                    link_missing_module "$scope_entry" "$destination/$name/${scope_entry##*/}"
                done
            else
                link_missing_module "$entry" "$destination/$name"
            fi
        done
        if [ -d "$module_path/.bin" ]; then
            [ ! -L "$destination/.bin" ] || continue
            mkdir -p "$destination/.bin"
            for entry in "$module_path/.bin"/*; do
                [ -e "$entry" ] || [ -L "$entry" ] || continue
                link_missing_module "$entry" "$destination/.bin/${entry##*/}"
            done
        fi
    done
}

activate_js_modules() {
    local link_path="$data_root/node_modules"
    if [ -L "$link_path" ]; then
        rm -f "$link_path"
    elif [ -e "$link_path" ]; then
        echo "sandbox-pkg: $link_path already exists and is not a symlink" >&2
        return 1
    fi
    ln -s "$deps_root/js/node_modules" "$link_path"
}

install_deb_packages() {
    local apt_get="/usr/bin/apt-get"
    local apt_cache="/usr/bin/apt-cache"
    local dpkg_deb="/usr/bin/dpkg-deb"
    if [ "$EUID" -eq 0 ]; then
        apt_get="$(command -v apt-get || true)"
        apt_cache="$(command -v apt-cache || true)"
        dpkg_deb="$(command -v dpkg-deb || true)"
    fi
    [ -x "$apt_get" ] || {
        echo "sandbox-pkg: apt-get is unavailable in this runtime" >&2
        exit 1
    }
    [ -x "$apt_cache" ] || {
        echo "sandbox-pkg: apt-cache is unavailable in this runtime" >&2
        exit 1
    }
    [ -x "$dpkg_deb" ] || {
        echo "sandbox-pkg: dpkg-deb is unavailable in this runtime" >&2
        exit 1
    }

    local apt_arch
    case "$(/usr/bin/uname -m)" in
        x86_64) apt_arch="amd64" ;;
        aarch64) apt_arch="arm64" ;;
        *) echo "sandbox-pkg: unsupported Debian architecture" >&2; exit 1 ;;
    esac

    local package requested name architecture version
    local package_names=()
    for package in "$@"; do
        requested="${package%%=*}"
        version=""
        if [[ "$package" == *=* ]]; then
            version="${package#*=}"
            if [ -z "$version" ] || [[ ! "$version" =~ ^[0-9A-Za-z][0-9A-Za-z.+:~_-]*$ ]]; then
                echo "sandbox-pkg: invalid Debian package version: $package" >&2
                exit 2
            fi
        fi
        name="$requested"
        architecture=""
        if [[ "$requested" == *:* ]]; then
            name="${requested%:*}"
            architecture="${requested##*:}"
        fi
        if [ "${#name}" -lt 2 ] \
            || [[ ! "$name" =~ ^[a-z0-9][a-z0-9+.-]*$ ]] \
            || [[ "$name" == *..* ]] \
            || [[ "$name" == *- ]] \
            || { [ -n "$architecture" ] && [ "$architecture" != "$apt_arch" ]; }; then
            echo "sandbox-pkg: invalid Debian package spec: $package" >&2
            exit 2
        fi
        package_names+=("$name")
    done

    export DEBIAN_FRONTEND=noninteractive

    local apt_root="$deps_root/apt"
    local deb_root="$deps_root/deb"
    local apt_config archive archive_root archive_root_quoted stage_root metadata found

    mkdir -p \
        "$apt_root/state/lists/partial" \
        "$apt_root/cache/archives" \
        "$deb_root"
    archive_root="$(mktemp -d "$apt_root/cache/archives/run.XXXXXX")"
    mkdir -p "$archive_root/partial" "$archive_root/apt.conf.d"
    stage_root="$archive_root/extracted"
    mkdir -p "$stage_root"
    apt_config="$archive_root/sandbox-pkg.conf"
    printf -v archive_root_quoted '%q' "$archive_root"
    trap "rm -rf -- $archive_root_quoted" EXIT
    local apt_options=(
        -o "APT::Sandbox::User="
        -o "Debug::NoLocking=true"
        -o "Acquire::Languages=none"
        -o "APT::Architecture=$apt_arch"
        -o "APT::Architectures::=$apt_arch"
        -o "APT::Get::AllowUnauthenticated=false"
        -o "Acquire::AllowInsecureRepositories=false"
        -o "Acquire::AllowDowngradeToInsecureRepositories=false"
        -o "Dir::Etc::sourcelist=/etc/apt/sources.list"
        -o "Dir::Etc::sourceparts=/etc/apt/sources.list.d"
        -o "Dir::Etc::trusted=/etc/apt/trusted.gpg"
        -o "Dir::Etc::trustedparts=/etc/apt/trusted.gpg.d"
        -o "Dir::State=$apt_root/state"
        -o "Dir::State::lists=$apt_root/state/lists"
        -o "Dir::State::status=/var/lib/dpkg/status"
        -o "Dir::Cache=$apt_root/cache"
        -o "Dir::Cache::archives=$archive_root"
    )
    printf 'Dir::Etc::parts "%s";\nDir::Etc::main "%s";\n' \
        "$archive_root/apt.conf.d" "$archive_root/apt.conf" > "$apt_config"
    : > "$archive_root/apt.conf"
    export APT_CONFIG="$apt_config"

    if [ ! -f "$apt_root/state/lists/.sandbox-pkg-updated" ]; then
        "$apt_get" "${apt_options[@]}" update
        touch "$apt_root/state/lists/.sandbox-pkg-updated"
    fi
    for name in "${package_names[@]}"; do
        metadata="$("$apt_cache" "${apt_options[@]}" show --no-all-versions "$name" 2>/dev/null || true)"
        found=false
        while IFS= read -r line; do
            if [ "$line" = "Package: $name" ]; then
                found=true
                break
            fi
        done <<< "$metadata"
        if [ "$found" != true ]; then
            echo "sandbox-pkg: Debian package not found: $name" >&2
            exit 1
        fi
    done
    "$apt_get" "${apt_options[@]}" \
        --yes \
        --no-install-recommends \
        --no-remove \
        --download-only \
        install "$@"

    for archive in "$archive_root"/*.deb; do
        [ -f "$archive" ] || continue
        "$dpkg_deb" --extract "$archive" "$stage_root"
    done
    find "$stage_root" -xdev -perm /6000 -exec chmod ug-s {} +
    cp -a "$stage_root"/. "$deb_root"/
    rm -rf "$archive_root"
    trap - EXIT
}

case "$manager" in
    pip|python)
        command -v python3 >/dev/null 2>&1 || {
            echo "sandbox-pkg: python3 is unavailable in this runtime" >&2
            exit 1
        }
        mkdir -p "$deps_root/python" "$deps_root/.cache/pip"
        exec python3 -m pip install \
            --disable-pip-version-check \
            --no-input \
            --upgrade \
            --target "$deps_root/python" \
            --cache-dir "$deps_root/.cache/pip" \
            "$@"
        ;;
    uv)
        command -v uv >/dev/null 2>&1 || {
            echo "sandbox-pkg: uv is unavailable in this runtime" >&2
            exit 1
        }
        mkdir -p "$deps_root/python" "$deps_root/.cache/uv"
        exec uv pip install \
            --upgrade \
            --target "$deps_root/python" \
            --cache-dir "$deps_root/.cache/uv" \
            "$@"
        ;;
    npm)
        command -v npm >/dev/null 2>&1 || {
            echo "sandbox-pkg: npm is unavailable in this runtime" >&2
            exit 1
        }
        prepare_js_root
        npm install \
            --prefix "$deps_root/js" \
            --cache "$deps_root/.cache/npm" \
            --no-audit \
            --no-fund \
            "$@"
        seed_baked_node_modules
        activate_js_modules
        ;;
    bun)
        command -v bun >/dev/null 2>&1 || {
            echo "sandbox-pkg: bun is unavailable in this runtime" >&2
            exit 1
        }
        prepare_js_root
        mkdir -p "$deps_root/.cache/bun"
        cd "$deps_root/js"
        bun add "$@"
        seed_baked_node_modules
        activate_js_modules
        ;;
    apt|deb)
        install_deb_packages "$@"
        ;;
    *)
        echo "sandbox-pkg: unsupported manager: $manager" >&2
        usage
        ;;
esac